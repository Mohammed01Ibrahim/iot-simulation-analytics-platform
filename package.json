{
  "name": "iot-simulation-analytics-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "receiver": "node --env-file-if-exists=.env src/receiver.js",
    "test": "node --test tests/unit.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration.test.js",
    "test:e2e": "playwright test",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "amqplib": "0.10.9",
    "csv-parse": "6.1.0",
    "express": "5.1.0",
    "minio": "8.0.6",
    "mongodb": "6.20.0",
    "mqtt": "5.14.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.12"
  }
}
